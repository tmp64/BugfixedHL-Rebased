		"xpos"				"r640"
		"ypos"				"24"
		"wide"				"628"
		"tall"				"468"
		
		"hor_padding"		"12"		// Left and right padding of a row
		"icon_padding"		"2"			// Left and tight padding of the kill icon
		"vert_margin"		"4"			// Distance between rows
